diff --git a/crates/buzz-sdk/src/identity.rs b/crates/buzz-sdk/src/identity.rs
new file mode 100644
index 00000000..aa2fcc2b
--- /dev/null
+++ b/crates/buzz-sdk/src/identity.rs
@@ -0,0 +1,93 @@
+//! Protected private-key input shared by Buzz binaries.
+
+use std::{
+    fs,
+    path::{Path, PathBuf},
+};
+use thiserror::Error;
+use zeroize::Zeroizing;
+
+const MAX_KEY_BYTES: u64 = 256;
+
+/// Secret-free private-key input errors.
+#[derive(Debug, Error)]
+pub enum IdentityError {
+    /// No key source was configured.
+    #[error("private key is required")]
+    Missing,
+    /// More than one key source was configured.
+    #[error("configure exactly one private key source")]
+    Multiple,
+    /// The protected key file was unsafe or malformed.
+    #[error("private key file is invalid")]
+    InvalidFile,
+}
+
+/// Read exactly one inline or protected regular-file private key.
+pub fn read_private_key(
+    inline: Option<String>,
+    file: Option<PathBuf>,
+) -> Result<Zeroizing<String>, IdentityError> {
+    match (inline, file) {
+        (None, None) => Err(IdentityError::Missing),
+        (Some(_), Some(_)) => Err(IdentityError::Multiple),
+        (Some(value), None) if valid(&value) => Ok(Zeroizing::new(value)),
+        (Some(_), None) => Err(IdentityError::InvalidFile),
+        (None, Some(path)) => read_file(&path),
+    }
+}
+
+fn read_file(path: &Path) -> Result<Zeroizing<String>, IdentityError> {
+    let metadata = fs::symlink_metadata(path).map_err(|_| IdentityError::InvalidFile)?;
+    if !metadata.file_type().is_file() || metadata.len() == 0 || metadata.len() > MAX_KEY_BYTES {
+        return Err(IdentityError::InvalidFile);
+    }
+    let mut bytes = Zeroizing::new(fs::read(path).map_err(|_| IdentityError::InvalidFile)?);
+    if bytes.last() == Some(&b'\n') {
+        bytes.pop();
+        if bytes.last() == Some(&b'\r') {
+            bytes.pop();
+        }
+    }
+    let value = String::from_utf8(bytes.to_vec()).map_err(|_| IdentityError::InvalidFile)?;
+    if !valid(&value) {
+        return Err(IdentityError::InvalidFile);
+    }
+    Ok(Zeroizing::new(value))
+}
+
+fn valid(value: &str) -> bool {
+    !value.is_empty() && !value.bytes().any(|b| b == 0 || b.is_ascii_whitespace())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::{fs::OpenOptions, io::Write};
+
+    #[test]
+    fn protected_file_parser_rejects_unsafe_shapes() {
+        let dir = std::env::temp_dir().join(format!("buzz-key-test-{}", std::process::id()));
+        let _ = fs::remove_dir_all(&dir);
+        fs::create_dir(&dir).unwrap();
+        let key = dir.join("key");
+        let mut f = OpenOptions::new()
+            .create_new(true)
+            .write(true)
+            .open(&key)
+            .unwrap();
+        writeln!(f, "{}", "1".repeat(64)).unwrap();
+        assert_eq!(read_private_key(None, Some(key.clone())).unwrap().len(), 64);
+        fs::write(&key, b"a\nb\n").unwrap();
+        assert!(read_private_key(None, Some(key.clone())).is_err());
+        fs::write(&key, vec![b'a'; 257]).unwrap();
+        assert!(read_private_key(None, Some(key.clone())).is_err());
+        #[cfg(unix)]
+        {
+            let link = dir.join("link");
+            std::os::unix::fs::symlink(&key, &link).unwrap();
+            assert!(read_private_key(None, Some(link)).is_err());
+        }
+        fs::remove_dir_all(dir).unwrap();
+    }
+}
